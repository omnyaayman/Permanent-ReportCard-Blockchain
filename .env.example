# =====================================================
# Permanent Report Card - Blockchain  |  Environment
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file.
# =====================================================

# Local blockchain RPC endpoint(s), comma-separated.
# Leave empty to use the default local Ganache ports.
# RPC_URL=http://127.0.0.1:7545
RPC_URL=

# Solidity compiler version used at deployment.
# SOLC_VERSION=0.8.0

# The wallet address used to deploy the contracts and act as global admin.
# MUST be one of the accounts in your running Ganache workspace.
# Example: ADMIN_ADDRESS=0x4B26Df0e2F67Bf2d2f04DC3fd0d3CddC315540d3
ADMIN_ADDRESS=your_admin_address

# Password gate for the demo CLI / GUI admin login. This is only a local
# demo convenience and is NOT the real security layer - the smart contract
# enforces actual admin authority on-chain.
ADMIN_PASSWORD=your_local_password

# Optional block explorer base URL. Leave empty on a plain Ganache workspace.
# Example: EXPLORER_URL=https://trufflesuite.com
# EXPLORER_URL=
